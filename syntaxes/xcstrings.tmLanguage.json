{
  "scopeName": "source.xcstrings",
  "name": "XCStrings",
  "patterns": [
    { "include": "#xcstringsKeys" },
    { "include": "#xcstringsValue" },
    { "include": "#xcstringsEntry" },
    { "include": "#xcstringsLocaleKey" },
    { "include": "#xcstringsState" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#boolean" },
    { "include": "#null" },
    { "include": "#punctuation" }
  ],

  "repository": {

    "xcstringsKeys": {
      "patterns": [
        {
          "name": "entity.name.tag.xcstrings",
          "match": "\"(sourceLanguage|strings|localizations|stringUnit|state|value|comment|version|extractionState|isCommentAutoGenerated)\"(?=\\s*:)"
        }
      ]
    },

    "xcstringsEntry": {
      "patterns": [
        {
          "name": "variable.other.xcstrings-entry",
          "match": "\"[^\"]*\"(?=\\s*:\\s*\\{)"
        }
      ]
    },

    "xcstringsState": {
      "patterns": [
        {
          "name": "constant.language.state.xcstrings",
          "match": "\"(translated|new|needs-review|untranslated)\""
        }
      ]
    },

    "xcstringsLocaleKey": {
      "patterns": [
        {
          "name": "support.constant.locale.xcstrings",
          "match": "\"[a-z]{2}(-[A-Za-z0-9]+)*\"(?=\\s*:\\s*\\{)"
        }
      ]
    },

    "xcstringsValue": {
      "patterns": [
        {
          "name": "string.quoted.double.xcstrings-value",
          "match": "(?<=\"value\"\\s*:\\s*)\"[^\"]*\""
        }
      ]
    },

    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.json",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.json",
              "match": "\\\\."
            }
          ]
        }
      ]
    },

    "number": {
      "patterns": [
        {
          "name": "constant.numeric.json",
          "match": "-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?"
        }
      ]
    },

    "boolean": {
      "patterns": [
        {
          "name": "constant.language.boolean.json",
          "match": "\\b(true|false)\\b"
        }
      ]
    },

    "null": {
      "patterns": [
        {
          "name": "constant.language.null.json",
          "match": "\\bnull\\b"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.dictionary.begin.json",
          "match": "\\{"
        },
        {
          "name": "punctuation.definition.dictionary.end.json",
          "match": "\\}"
        },
        {
          "name": "punctuation.definition.array.begin.json",
          "match": "\\["
        },
        {
          "name": "punctuation.definition.array.end.json",
          "match": "\\]"
        },
        {
          "name": "punctuation.separator.dictionary.key-value.json",
          "match": ":"
        },
        {
          "name": "punctuation.separator.array.json",
          "match": ","
        }
      ]
    }

  }
}
